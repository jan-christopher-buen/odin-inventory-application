{
  "name": "odin-inventory-application",
  "version": "1.0.0",
  "description": "A server-rendered inventory management app built with Express, EJS, and PostgreSQL, featuring category and item CRUD with validated forms.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "db:setup": "node --env-file-if-exists=.env scripts/setup.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jan-christopher-buen/odin-inventory-application.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jan-christopher-buen/odin-inventory-application/issues"
  },
  "homepage": "https://github.com/jan-christopher-buen/odin-inventory-application#readme",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ejs": "^3.1.10",
    "pg": "^8.16.3",
    "express-validator": "^7.2.1",
    "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
