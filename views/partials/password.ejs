<div class="admin-box">
  <label for="admin_password">Admin password *</label>
  <p class="hint" id="admin-hint">Confirm this action with the shared admin password.</p>
  <input type="password" id="admin_password" name="admin_password" required autocomplete="current-password" aria-invalid="<%= Boolean(error) %>" aria-describedby="admin-hint admin-error">
  <p class="field-error" id="admin-error"><%= error || '' %></p>
</div>
